SWGOH_GATEWAY_URL=https://swgoh-live-gateway-production.up.railway.app
SWGOH_GATEWAY_API_KEY=replace-with-the-same-secret-used-by-the-gateway
SWGOH_REQUEST_TIMEOUT_MS=35000
SWGOH_MOD_REQUEST_TIMEOUT_MS=45000
SWGOH_GUILD_REQUEST_TIMEOUT_MS=120000
SWGOH_CACHE_FRESH_SECONDS=90
SWGOH_CACHE_STALE_SECONDS=600
SWGOH_CACHE_MAX_ENTRIES=500
SWGOH_MOD_CACHE_FRESH_SECONDS=300
SWGOH_MOD_CACHE_STALE_SECONDS=900
SWGOH_MOD_CACHE_MAX_ENTRIES=500
SWGOH_GUILD_CACHE_FRESH_SECONDS=600
SWGOH_GUILD_CACHE_STALE_SECONDS=1800
SWGOH_GUILD_CACHE_MAX_ENTRIES=100
SWGOH_ROTE_CACHE_SECONDS=21600
SWGOH_ROTE_OPERATIONS_URL=https://raw.githubusercontent.com/swgoh-utils/gamedata/main/swgoh_rote_operations.json

# Production Supabase. The service-role key is server-only and must never be exposed to browser code or committed.
SUPABASE_URL=https://twfrmixsqhgnzpmegzan.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Production cookies must remain Secure. Set false only for explicit local HTTP development.
AUTH_COOKIE_SECURE=true

# Durable shared command state. On Railway, attaching a Volume automatically provides RAILWAY_VOLUME_MOUNT_PATH;
# the app will then use <mount>/swgoh-command-center without another variable. SWGOH_STATE_DIR is an optional override.
SWGOH_STATE_DIR=
# Set true only when SWGOH_STATE_DIR points at storage you have independently confirmed persists across deploys/restarts.
SWGOH_STATE_STORAGE_CONFIRMED_DURABLE=false
SWGOH_STATE_MAX_BYTES=5242880
SWGOH_STATE_MAX_PLAN_VERSIONS=100

# Discord TB command integration. Keep secrets in Railway variables; never expose them to browser code.
DISCORD_TB_INTERACTIONS_ENABLED=false
DISCORD_TB_DELIVERY_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_DEFAULT_GUILD_ID=
# Any 9-digit Ally Code belonging to the pilot SWGOH guild. Used only server-side to resolve the live guild roster.
DISCORD_DEFAULT_ALLY_CODE=
# Mission-owner redundancy target used by Discord assignment/farm reads (1-5).
DISCORD_TB_REDUNDANCY_TARGET=2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
# Optional later one-way delivery pilot. Treat webhook URLs as passwords.
DISCORD_TB_WEBHOOK_URL=

# Website-native Action Center runs without Discord. This flag controls only the optional "Share to Discord" adapter.
# When left blank, the adapter follows DISCORD_TB_DELIVERY_ENABLED for backward-compatible deployment behavior.
WEB_ACTION_DISCORD_SHARING_ENABLED=
