{
  "name": "swgoh-live-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start-production.mjs",
    "build": "node --test test/discord-donation-preference.test.mjs test/discord-tb-preference-command.test.mjs test/discord-canonical-controls-contract.test.mjs test/cloudflare-oauth-cookie-proxy.test.mjs test/public-auth-origin-contract.test.mjs && node scripts/build-production-data.mjs",
    "test": "node --test",
    "verify": "node --test",
    "report:tb-coverage": "node scripts/report-tb-strategy-coverage.mjs",
    "report:tb-research": "node scripts/report-tb-strategy-research-queue.mjs",
    "build:interactions": "node scripts/build-interaction-index.mjs",
    "sync:combat-data": "node scripts/sync-raw-combat-data.mjs --allow-stale && node scripts/build-interaction-index.mjs",
    "sync:gamedata": "node scripts/sync-gamedata.mjs --allow-stale && node scripts/repair-catalog.mjs --allow-stale && node scripts/enrich-kit-intelligence.mjs && node scripts/sync-raw-combat-data.mjs --allow-stale && node scripts/build-interaction-index.mjs",
    "sync:catalog-db": "node scripts/sync-game-unit-catalog-db.mjs",
    "discord:register-tb": "node scripts/register-discord-tb-commands.mjs",
    "discord:patch-stage9": "node scripts/patch-discord-stage9-plan-commands.mjs",
    "discord:patch-stage10": "node scripts/patch-discord-stage10-delivery-commands.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
